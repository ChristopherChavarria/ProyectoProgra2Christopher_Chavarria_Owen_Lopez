
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ActividadController"
            stylesheets="@estilos.css"
            prefWidth="1200"
            prefHeight="800"
            minWidth="950"
            minHeight="650"
            style="-fx-background-color: #080f22;">

    <top>
        <VBox spacing="6"
              style="-fx-background-color: #080f22; -fx-padding: 22 28 12 28;">

            <Label text="Gestión de actividades"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

            <Label text="Organizá y administrá tus actividades, horarios y cupos."
                   style="-fx-font-size: 14px; -fx-text-fill: #9fb5d9;"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="16"
              fillWidth="true"
              style="-fx-background-color: #080f22; -fx-padding: 10 28 22 28;">

            <VBox spacing="15"
                  style="-fx-background-color: #101b30; -fx-background-radius: 12; -fx-border-color: #344d73; -fx-border-radius: 12; -fx-padding: 20;">

                <Label text="Nueva actividad"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

                <HBox spacing="24"
                      fillHeight="true">

                    <GridPane hgap="12"
                              vgap="14"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS">

                        <columnConstraints>
                            <ColumnConstraints minWidth="100"
                                               prefWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Nombre:"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Nombre de la actividad"
                                   maxWidth="Infinity"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Descripción:"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="txtDescripcion"
                                   promptText="Descripción de la actividad"
                                   maxWidth="Infinity"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Fecha:"
                               GridPane.rowIndex="2"/>

                        <DatePicker fx:id="dpFecha"
                                    promptText="Seleccioná una fecha"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>

                        <Label text="Ubicación:"
                               GridPane.rowIndex="3"/>

                        <TextField fx:id="txtUbicacion"
                                   promptText="Lugar de la actividad"
                                   maxWidth="Infinity"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"/>

                    </GridPane>

                    <GridPane hgap="12"
                              vgap="14"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS">

                        <columnConstraints>
                            <ColumnConstraints minWidth="125"
                                               prefWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Hora de inicio:"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtHoraInicio"
                                   promptText="Ejemplo: 14:00"
                                   maxWidth="Infinity"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Hora de finalización:"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="txtHoraFin"
                                   promptText="Ejemplo: 16:00"
                                   maxWidth="Infinity"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Capacidad máxima:"
                               GridPane.rowIndex="2"/>

                        <Spinner fx:id="spnCapacidadMax"
                                 editable="true"
                                 maxWidth="Infinity"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="2"/>

                    </GridPane>

                </HBox>

                <HBox spacing="12"
                      alignment="CENTER_RIGHT">

                    <Button fx:id="btnVolver"
                            text="Volver al menú"
                            mnemonicParsing="false"
                            onAction="#regresarPrincipal"
                            styleClass="boton-secundario"
                            prefHeight="43"/>

                    <Button fx:id="btnGuardar"
                            text="Guardar actividad"
                            mnemonicParsing="false"
                            onAction="#guardarActividad"
                            styleClass="boton-primario"
                            prefHeight="43"/>

                </HBox>

            </VBox>

            <VBox spacing="12"
                  minHeight="240"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #101b30; -fx-background-radius: 12; -fx-border-color: #344d73; -fx-border-radius: 12; -fx-padding: 18;">

                <Label text="Actividades registradas"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

                <Label text="Consultá las actividades guardadas en el sistema."
                       style="-fx-font-size: 13px; -fx-text-fill: #9fb5d9;"/>

                <TableView fx:id="tableActividades"
                           prefHeight="320"
                           minHeight="170"
                           maxHeight="Infinity"
                           maxWidth="Infinity"
                           VBox.vgrow="ALWAYS"
                           columnResizePolicy="CONSTRAINED_RESIZE_POLICY">

                    <placeholder>
                        <Label text="No hay actividades registradas"
                               style="-fx-text-fill: #9fb5d9; -fx-font-size: 15px;"/>
                    </placeholder>

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="55"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="140"/>

                        <TableColumn fx:id="colDescripcion"
                                     text="Descripción"
                                     prefWidth="190"/>

                        <TableColumn fx:id="colFecha"
                                     text="Fecha"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colHoraInicio"
                                     text="H. Inicio"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colHoraFin"
                                     text="H. Fin"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colUbicacion"
                                     text="Ubicación"
                                     prefWidth="160"/>

                        <TableColumn fx:id="colCapacidad"
                                     text="Cupo"
                                     prefWidth="85"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>
